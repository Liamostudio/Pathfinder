# Copy to .env (git-ignored). Never commit real keys, never paste them in chat.
# Meta Model API key (sent as a bearer token to https://api.meta.ai/v1). Docs call it MODEL_API_KEY.
MODEL_API_KEY=
# muse-spark-1.3 (standard) or muse-spark-1.3-contributor (cheaper; your calls help improve Meta products)
MUSE_SPARK_MODEL=muse-spark-1.3
